#!/bin/sh
# Run devcluster from this checkout with a Python 3.11 or newer found on PATH.
root=$(cd -P "$(dirname "$0")/.." && pwd) || exit 1
for py in python3 python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    PYTHONPATH="$root/src" exec "$py" -P -m devcluster "$@"
  fi
done
echo "devcluster needs Python 3.11 or newer on PATH." >&2
exit 1
